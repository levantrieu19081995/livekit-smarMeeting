APP_NAME=meeting-fastapi
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_ENVIRONMENT=production

LIVEKIT_URL=ws://127.0.0.1:7880
# Set real server credentials before starting; no development credential fallback.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

CAPTURE_ROOT_DIR=./data/meetings
CAPTURE_SAMPLE_RATE=48000
CAPTURE_NUM_CHANNELS=1
CAPTURE_SAMPLE_WIDTH_BYTES=2
CAPTURE_AUDIO_STREAM_CAPACITY=200
CAPTURE_WRITE_QUEUE_CAPACITY=8
CAPTURE_WRITE_BATCH_MS=250
CAPTURE_CONNECT_TIMEOUT_SECONDS=15
CAPTURE_CLOSE_TIMEOUT_SECONDS=5
CAPTURE_MAX_ACTIVE_SESSIONS=20
CAPTURE_MAX_AUDIO_TRACKS=200
CAPTURE_TERMINAL_CACHE_SIZE=64
CAPTURE_MAX_EVENTS=10000

# Shared secret of at least 24 characters. Must match Java AI_INTERNAL_API_KEY.
# Production refuses startup with a missing/default key or disabled authentication.
INTERNAL_API_KEY=
REQUIRE_INTERNAL_API_KEY=true
# Local-only opt-out requires BOTH APP_ENVIRONMENT=development and
# REQUIRE_INTERNAL_API_KEY=false. AI conclusion still always requires a key.
MAX_REQUEST_BODY_BYTES=2097152
REQUEST_BODY_TIMEOUT_SECONDS=15

OPENAI_API_KEY=

# AI Result / conclusion; internal key is always required for this route.
CONCLUSION_MODEL=gpt-4o-mini
CONCLUSION_ROOT_DIR=./data/ai-conclusions
CONCLUSION_TIMEOUT_SECONDS=90
CONCLUSION_MAX_INPUT_CHARS=150000
CONCLUSION_MAX_OUTPUT_TOKENS=12000

STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
STT_CHUNK_SECONDS=180
STT_CONCURRENCY=4
STT_MAX_ACTIVE_JOBS=8
STT_MAX_PENDING_JOBS=200
STT_TERMINAL_CACHE_SIZE=64
STT_PREPROCESS_CONCURRENCY=2
STT_MAX_CALLBACK_TASKS=256
STT_MAX_RETRIES=2
STT_RETRY_BASE_SECONDS=1.0
STT_TIMEOUT_SECONDS=90
STT_JOB_TIMEOUT_SECONDS=14400
STT_MAX_AUDIO_BYTES=24000000
STT_MAX_MANIFEST_BYTES=10485760
STT_MAX_CHUNKS_PER_JOB=10000
STT_MAX_SEGMENT_SECONDS=28800
STT_MAX_TEXT_CHARS=12000

MEETING_SERVICE_BASE_URL=http://localhost:8080
STT_PROGRESS_CALLBACK_ENABLED=true
STT_PROGRESS_CALLBACK_TIMEOUT_SECONDS=5.0
STT_PROGRESS_CALLBACK_MIN_PERCENT_STEP=5.0
STT_COMPLETION_CALLBACK_ENABLED=true
STT_COMPLETION_CALLBACK_TIMEOUT_SECONDS=5.0
STT_COMPLETION_CALLBACK_MAX_ATTEMPTS=5
STT_COMPLETION_CALLBACK_RETRY_BASE_SECONDS=0.5
